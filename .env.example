# Copy to .env and adjust. All keys are optional; defaults run against local SQLite.
DATABASE_URL=sqlite+pysqlite:///./taxwise.db
ENVIRONMENT=local
DEBUG=false
SQL_ECHO=false
DOCUMENTS_DIR=./documents

# Assistant: retrieval threshold, top-k, embedder and LLM provider.
# The default stub is deterministic and needs no network or secret.
ASSISTANT_MIN_SCORE=0.25
ASSISTANT_TOP_K=5
ASSISTANT_EMBEDDER=hashing
ASSISTANT_LLM=stub
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# OpenAI-compatible backend (optional). Never commit a real key.
# ASSISTANT_LLM=openai
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_MODEL=gpt-4o-mini
# ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1

# Production example (requires the "postgres" extra):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/taxwise
# ENVIRONMENT=prod
