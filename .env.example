# Copy to .env and adjust. All keys are optional; defaults run against local SQLite.
DATABASE_URL=sqlite+pysqlite:///./taxwise.db
ENVIRONMENT=local
DEBUG=false
SQL_ECHO=false
DOCUMENTS_DIR=./documents

# Retention: documents older than RETENTION_YEARS become purge candidates.
# RETENTION_CONFIRMATION_TOKEN is required only for the irreversible purge
# (POST /api/admin/retention/run?dry_run=false, header X-Retention-Token).
# Leave it unset to disable deletion entirely. Never commit a real token.
RETENTION_YEARS=5
# RETENTION_CONFIRMATION_TOKEN=

# Assistant: retrieval threshold, top-k, embedder and LLM provider.
# The default stub is deterministic and needs no network or secret.
ASSISTANT_MIN_SCORE=0.25
ASSISTANT_TOP_K=5
ASSISTANT_EMBEDDER=hashing
ASSISTANT_LLM=stub
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# OpenAI-compatible backend (optional). Never commit a real key.
# ASSISTANT_LLM=openai
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_MODEL=gpt-4o-mini
# ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1

# Invoice API imports (optional; the CSV import needs no configuration).
# There is no default URL on purpose - ApiProvider refuses to run without both.
# ACCOUNTING_API_URL=https://api.example.pl
# ACCOUNTING_API_TOKEN=
# ACCOUNTING_API_INVOICES_PATH=invoices
# ACCOUNTING_API_TIMEOUT_SECONDS=30

# Production example (requires the "postgres" extra):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/taxwise
# ENVIRONMENT=prod
